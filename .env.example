# Copy to .env and fill in. Both values are public by design (RLS protects the data).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Local provisioning script only (npm run provision:doctors). Put these in
# .env.local, never in a VITE_ variable, never commit them.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here
# DEMO_ADMIN_PASSWORD=
# DEMO_DOCTOR_PASSWORD=

# Guarded SQL runner only (npm run db). Dashboard -> Connect -> Session pooler.
# Contains the database password: .env.local only.
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@your-pooler-host:5432/postgres
# SUPABASE_DB_CA_FILE=path/to/supabase-ca.crt   # optional: verify the server certificate
